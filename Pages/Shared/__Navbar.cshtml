@{
    var currentCshtmlName = ViewData["CshtmlName"]?.ToString() ?? string.Empty;
}

<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0">
        <a asp-area="" asp-page="/Index" class="navbar-brand p-0">
            <!-- <h1 class="m-0"><i class="fa fa-user-tie me-2"></i>Indotalent Software Ltd</h1> -->
            <!-- Replace starts here -->
            <div class="d-inline-flex align-items-center bg-white px-4 py-3 shadow-sm rounded-bottom" style="line-height: 1;">
                <!-- Gear / Tech Icon -->
                <svg width="48" height="48" viewBox="0 0 64 64" fill="none" class="me-3 flex-shrink-0" xmlns="http://www.w3.org/2000/svg">
                    <path d="M28 4h8l2 6 6 2 5-4 6 6-4 5 2 6 6 2v8l-6 2-2 6 4 5-6 6-5-4-6 2-2 6h-8l-2-6-6-2-5 4-6-6 4-5-2-6-6-2v-8l6-2 2-6-4-5 6-6 5 4 6-2 2-6z" 
                          fill="#06A3DA" opacity="0.12"/>
                    <path d="M29 6h6l1.8 5.4a19.5 19.5 0 0 1 5.3 2.2l5.1-2.9 4.2 4.2-2.9 5.1c.9 1.6 1.7 3.4 2.2 5.3L56 27v6l-5.4 1.8a19.5 19.5 0 0 1-2.2 5.3l2.9 5.1-4.2 4.2-5.1-2.9a19.5 19.5 0 0 1-5.3 2.2L35 54h-6l-1.8-5.4a19.5 19.5 0 0 1-5.3-2.2l-5.1 2.9-4.2-4.2 2.9-5.1a19.5 19.5 0 0 1-2.2-5.3L8 33v-6l5.4-1.8a19.5 19.5 0 0 1 2.2-5.3l-2.9-5.1 4.2-4.2 5.1 2.9a19.5 19.5 0 0 1 5.3-2.2L29 6z" 
                          stroke="#091E3E" stroke-width="4.5" stroke-linejoin="round" fill="none"/>
                    <circle cx="25" cy="24" r="3.5" fill="#06A3DA" />
                    <path d="M25 31v14" stroke="#06A3DA" stroke-width="4" stroke-linecap="round"/>
                    <path d="M25 37l16-16m0 0h-12m12 0v12" stroke="#06A3DA" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                <!-- Company Text -->
                <div class="d-flex flex-column justify-content-center text-start">
                    <span style="font-size: 2rem; font-weight: 800; color: #091E3E; letter-spacing: -0.5px; line-height: 1.1;">
                        Indotalent
                    </span>
                    <span style="font-size: 1.05rem; font-weight: 500; color: #555; letter-spacing: 0.2px; margin-top: 2px;">
                        Software Ltd
                    </span>
                </div>
            </div>
            <!-- Replace ends here -->
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a asp-area="" asp-page="/Index" class="nav-item nav-link @(currentCshtmlName.Equals("") ? "active" : "")">Home</a>
                <a asp-area="" asp-page="/About" class="nav-item nav-link @(currentCshtmlName.Equals("About") ? "active" : "")">About</a>
                <a asp-area="" asp-page="/Services" class="nav-item nav-link @(currentCshtmlName.Equals("Services") ? "active" : "")">Services</a>
                <a asp-area="" asp-page="/Blog" class="nav-item nav-link @(currentCshtmlName.Equals("Blog") ? "active" : "")">Blog</a>
                <a asp-area="" asp-page="/Contact" class="nav-item nav-link @(currentCshtmlName.Equals("Contact") ? "active" : "")">Contact</a>
            </div>
            <butaton type="button" class="btn text-primary ms-3" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fa fa-search"></i></butaton>
            
        </div>
    </nav>

    @if (currentCshtmlName == string.Empty)
    {
        <!-- Hero Start -->
        @await Html.PartialAsync("__Hero")
        <!-- Hero Start -->
    } else
    {
        <!-- Header Start -->
        @await Html.PartialAsync("__Header")
        <!-- Header Start -->
        
    }

</div>